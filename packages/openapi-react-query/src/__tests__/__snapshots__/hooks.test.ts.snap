import { queryOptions, useQuery, type UseQueryOptions, useInfiniteQuery, type UseInfiniteQueryOptions, type InfiniteData, type QueryKey, useMutation, type UseMutationOptions } from '@tanstack/react-query'
import { createPost, getPost, listPosts, type ApiError } from './client.js'

// ── Query key factories ──────────────────────────────────────

export const postKeys = {
  all: () => ["posts"] as const,
  list: (params?: Parameters<typeof listPosts>[0]) => ["posts", 'list', params] as const,
  detail: (id: Parameters<typeof getPost>[0]) => ["posts", id] as const,
}

// ── Query options factories ──────────────────────────────────

export function listPostsQueryOptions<TData = Awaited<ReturnType<typeof listPosts>>>(
  params?: Parameters<typeof listPosts>[0],
  options?: Omit<UseQueryOptions<Awaited<ReturnType<typeof listPosts>>, ApiError, TData>, 'queryKey' | 'queryFn'>,
) {
  return queryOptions<Awaited<ReturnType<typeof listPosts>>, ApiError, TData>({
    queryKey: postKeys.list(params),
    queryFn: () => listPosts(params),
    staleTime: 0,
    gcTime: 300000,
    ...options,
  })
}

export function getPostQueryOptions<TData = Awaited<ReturnType<typeof getPost>>>(
  id: Parameters<typeof getPost>[0],
  options?: Omit<UseQueryOptions<Awaited<ReturnType<typeof getPost>>, ApiError, TData>, 'queryKey' | 'queryFn'>,
) {
  return queryOptions<Awaited<ReturnType<typeof getPost>>, ApiError, TData>({
    queryKey: postKeys.detail(id),
    queryFn: () => getPost(id),
    staleTime: 0,
    gcTime: 300000,
    ...options,
  })
}

// ── Queries ──────────────────────────────────────────────────

export function useListPosts<TData = Awaited<ReturnType<typeof listPosts>>>(
  params?: Parameters<typeof listPosts>[0],
  options?: Omit<UseQueryOptions<Awaited<ReturnType<typeof listPosts>>, ApiError, TData>, 'queryKey' | 'queryFn'>,
) {
  return useQuery<Awaited<ReturnType<typeof listPosts>>, ApiError, TData>({
    queryKey: postKeys.list(params),
    queryFn: () => listPosts(params),
    staleTime: 0,
    gcTime: 300000,
    ...options,
  })
}

export function useListPostsInfinite<TData = InfiniteData<Awaited<ReturnType<typeof listPosts>>>>(
  params?: Parameters<typeof listPosts>[0],
  options?: Omit<UseInfiniteQueryOptions<Awaited<ReturnType<typeof listPosts>>, ApiError, TData, QueryKey, unknown>, 'queryKey' | 'queryFn' | 'getNextPageParam' | 'initialPageParam'>,
) {
  return useInfiniteQuery<Awaited<ReturnType<typeof listPosts>>, ApiError, TData, QueryKey, unknown>({
