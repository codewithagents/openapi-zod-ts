    // Override getNextPageParam in options to enable actual pagination.
    getNextPageParam: () => undefined,
    staleTime: 0,
    gcTime: 300000,
    ...options,
  })
}

export function useGetPost<TData = Awaited<ReturnType<typeof getPost>>>(
  id: Parameters<typeof getPost>[0] | undefined | null,
  options?: Omit<UseQueryOptions<Awaited<ReturnType<typeof getPost>>, ApiError, TData>, 'queryKey' | 'queryFn'>,
) {
  return useQuery<Awaited<ReturnType<typeof getPost>>, ApiError, TData>({
    queryKey: postKeys.detail(id!),
    queryFn: () => getPost(id!),
    staleTime: 0,
    gcTime: 300000,
