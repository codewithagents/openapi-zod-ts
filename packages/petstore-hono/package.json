{
  "name": "@codewithagents/petstore-hono",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node node_modules/openapi-zod-ts/dist/cli.cjs && node node_modules/@codewithagents/openapi-server/dist/cli.cjs && node node_modules/@codewithagents/openapi-react-query/dist/cli.js",
    "dev": "pnpm generate && concurrently \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "pnpm generate && vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.typecheck.json",
    "test:e2e": "pnpm generate && vite build && playwright test"
  },
  "dependencies": {
    "@codewithagents/openapi-react-query": "workspace:*",
    "@codewithagents/openapi-server": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@tanstack/react-query": "catalog:",
    "hono": "^4.13.16",
    "openapi-zod-ts": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "^8.3.5"
  }
}
