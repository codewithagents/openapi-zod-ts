{
  "name": "@codewithagents/integration",
  "private": true,
  "description": "Cross-package integration tests and live sample code for openapi-zod-ts + @codewithagents/api-errors.",
  "type": "module",
  "scripts": {
    "generate": "openapi-zod-ts --config openapi-zod-ts.config.json",
    "generate:hooks": "openapi-react-query --config openapi-react-query.config.json",
    "generate:mocks": "openapi-msw --config openapi-msw.config.json",
    "generate:matrix": "openapi-zod-ts --config openapi-zod-ts.matrix.config.json && node node_modules/@codewithagents/openapi-server/dist/cli.cjs --config openapi-server.matrix.config.json",
    "generate:legit-unknown": "openapi-zod-ts --config openapi-zod-ts.legit-unknown.config.json",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint generated/ generated-matrix/ generated-matrix-legit/"
  },
  "dependencies": {
    "@codewithagents/api-errors": "workspace:*",
    "@codewithagents/openapi-msw": "workspace:*",
    "@codewithagents/openapi-react-query": "workspace:*",
    "openapi-zod-ts": "workspace:*"
  },
  "devDependencies": {
    "@codewithagents/openapi-server": "workspace:*",
    "@faker-js/faker": "^10.6.0",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
